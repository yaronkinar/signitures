# Local dev only (`npm run dev`). Not embedded in production builds.
VITE_OPENAI_API_KEY=sk-your-key-here
# VITE_OPENAI_BASE_URL=https://api.openai.com/v1
# VITE_OPENAI_MODEL=gpt-4o-mini

# Vercel → Project → Settings → Environment Variables (Production / Preview)
# Use OPENAI_API_KEY (recommended). VITE_OPENAI_API_KEY is also supported by the API route.
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Vercel → Storage → Blob (auto-provisioned as BLOB_READ_WRITE_TOKEN on deploy)
# Enables cloud Save / Open saved in the app. Without it, saves stay in browser localStorage.
# BLOB_READ_WRITE_TOKEN=
