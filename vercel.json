{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**": {
      "maxDuration": 60
    }
  },
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!api/)(?!@vite)(?!@react-refresh)(?!node_modules/)(?!he$)(?!he/)(?!guides$)(?!guides/)(?!.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
